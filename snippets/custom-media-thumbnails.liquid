{% comment %}
  Custom Media Thumbnails Component
  Integrates with product__image-gallery-b.liquid without modifying the original
  Shows additional thumbnail navigation for product images
{% endcomment %}

{% assign variant_images_count = 0 %}
{% for variant in product.variants %}
  {% if variant.featured_image %}
    {% assign variant_images_count = variant_images_count | plus: 1 %}
  {% endif %}
{% endfor %}

<div>
  <div class="custom-media-thumbnails px-3 lg:px-6 w-full pt-3" style="display: none;">
    {% if variant_images_count > 1 %}
      <div
        class="flex gap-3 w-full overflow-x-auto scroll-smooth"
        x-data="
          {
            handleThumbnailClick(imageId, variantId) {
              const mainGallery = document.querySelector('[x-data*=activeImageId]');
              if (mainGallery && mainGallery._x_dataStack) {
                const galleryData = mainGallery._x_dataStack[0];
                if (galleryData.handleImageClick) {
                  galleryData.handleImageClick(imageId, variantId);
                }
              }

              if (variantId && window.Alpine && window.Alpine.store('main')) {
                window.Alpine.store('main').setActiveVariantId(variantId);
              }
            },
            handleThumbnailHover(imageId, variantId) {
              const mainGallery = document.querySelector('[x-data*=activeImageId]');
              if (mainGallery && mainGallery._x_dataStack) {
                const galleryData = mainGallery._x_dataStack[0];
                if (galleryData.handleImageHover) {
                  galleryData.handleImageHover(imageId);
                }
              }
            }
          }
        "
      >
        {% for variant in product.variants %}
          {% if variant.featured_image %}
            <div
              class="thumbnail-item cursor-pointer flex-none w-1/4"
              style="min-width: 24.5%; max-width: 24.5%;"
              @click="handleThumbnailClick({{ variant.featured_image.id }}, {{ variant.id }})"
              @mouseover="handleThumbnailHover({{ variant.featured_image.id }}, {{ variant.id }})"
            >
              <div class="relative overflow-hidden aspect-square">
                <img
                  src="{{ variant.featured_image | image_url: width: variant.featured_image.width, height: variant.featured_image.height }}"
                  alt="{{ variant.title }}"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="{{ variant.featured_image.width }}"
                  height="{{ variant.featured_image.height }}"
                >
                <div class="absolute inset-0 bg-black opacity-0 hover:opacity-10 transition-opacity duration-200"></div>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% for image in product.images %}
          {% assign is_variant_image = false %}
          {% for variant in product.variants %}
            {% if variant.featured_image.id == image.id %}
              {% assign is_variant_image = true %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% unless is_variant_image %}
            <div
              class="thumbnail-item cursor-pointer flex-none w-1/4"
              style="min-width: 24.5%; max-width: 24.5%;"
              @click="handleThumbnailClick({{ image.id }}, null)"
              @mouseover="handleThumbnailHover({{ image.id }}, null)"
            >
              <div class="relative overflow-hidden aspect-square">
                <img
                  src="{{ image | image_url: width: image.width, height: image.height }}"
                  alt="{{ product.title }}"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
                <div class="absolute inset-0 bg-black opacity-0 hover:opacity-10 transition-opacity duration-200"></div>
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      </div>

    {% else %}
      <div
        class="flex gap-3 w-full scroll-smooth"
        style="overflow-x: auto;"
        x-data="
          {
            handleThumbnailClick(imageIndex) {
              const mainGallery = document.querySelector('[x-data*=activeImage]');
              if (mainGallery && mainGallery._x_dataStack) {
                const galleryData = mainGallery._x_dataStack[0];
                if (galleryData.activeImage !== undefined) {
                  galleryData.activeImage = imageIndex;
                }
              }
            },
            handleThumbnailHover(imageIndex) {
              const mainGallery = document.querySelector('[x-data*=activeImage]');
              if (mainGallery && mainGallery._x_dataStack) {
                const galleryData = mainGallery._x_dataStack[0];
                if (galleryData.activeImage !== undefined) {
                  galleryData.activeImage = imageIndex;
                }
              }
            }
          }
        "
      >
        {% for image in product.images %}
          <div
            class="thumbnail-item cursor-pointer flex-none w-1/4"
            style="min-width: 24.5%; max-width: 24.5%;"
            @click="handleThumbnailClick({{ forloop.index }})"
            @mouseover="handleThumbnailHover({{ forloop.index }})"
          >
            <div class="relative overflow-hidden aspect-square">
              <img
                src="{{ image | image_url: width: image.width, height: image.height }}"
                alt="{{ product.title }}"
                class="w-full h-full object-cover"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
              <div class="absolute inset-0 bg-black opacity-0 hover:opacity-10 transition-opacity duration-200"></div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<div class="new_rebuy_cross_sell pb-16" style="max-width: 730px; margin: 0 auto;"></div>