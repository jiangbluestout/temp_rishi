              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80 max-w-[450px]"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_mobile }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>
            

            {%  assign btn_layout = "" %}
            {% if section.settings.button_layout_desktop == "left" %}
              {% assign btn_layout = "left: 0;    transform: translate(0, 0);    margin-left: 2.5rem;" %}
            {% else if section.settings.button_layout_desktop == "right" %}
              {% assign btn_layout = "right: 0;    transform: translate(0, 0);    margin-right: 2.5rem;" %}
            {% endif %} 
            {% if section.settings.button_layout_desktop == "center" %}
              {% assign btn_layout = "" %}
            {% endif %}
            {% if section.settings.button_border_image != blank %}
              <button class="fs-dsk-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-image-source: url({{ section.settings.button_border_image | img_url }}); border-image-slice: 1; border-image-repeat: stretch; border-width: 2px;" >{{ section.settings.button_text }}</button>
            {% else %}
              <button class="fs-dsk-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-color: {{ section.settings.button_border_color }};">{{ section.settings.button_text }}</button>
            {% endif %}



            {%  assign btn_layout_mob = "" %}
            {% if section.settings.button_layout_mobile == "left" %}
              {% assign btn_layout_mob = "right: 50%; margin-left: 20px;" %}
            {% else if section.settings.button_layout_mobile == "right" %}
              {% assign btn_layout_mob = "left: 50%; margin-right: 20px;" %}
            {% endif %} 
            {% if section.settings.button_layout_mobile == "center" %}
              {% assign btn_layout_mob = "" %}
            {% endif %}
            {% if section.settings.button_border_image != blank %}
              <button class="fs-mob-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout_mob}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-image-source: url({{ section.settings.button_border_image | img_url }}); border-image-slice: 1; border-image-repeat: stretch; border-width: 2px;">{{ section.settings.button_text }}</button>
            {% else %}
              <button class="fs-mob-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout_mob}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-color: {{ section.settings.button_border_color }};">{{ section.settings.button_text }}</button>
            {% endif %}
          </div>
        </div>
        <div class="lg:w-1/2 fs-dsk-only-show" style="animation: fadeIn 200ms ease-in-out">
              {% if section.settings.image_one %}
                {% render 'image',
                  image_desktop: section.settings.image_one,
                  image_mobile: section.settings.image_one,
                  width_desktop: '2000x',
                  width_mobile: '800x',
                  ratio_desktop: '100%',
                  ratio_mobile: '100%',
                  lazy: true,
                  image_classes: 'xl:max-h-screen',
                %}
              {% endif %}
        </div>
        <!-- mobile reponsive  -->
        <div class="h-[700px] md:h-auto lg:w-1/2 relative aspect-auto lg:aspect-auto fs-mob-only-show">
          {% if section.settings.image_mobile %}
            {% render 'image',
              image_desktop: section.settings.image_mobile,
              image_mobile: section.settings.image_mobile,
              width_desktop: '2000x',
              width_mobile: '800x',
              ratio_desktop: '100%',
              ratio_mobile: '100%',
              lazy: true,
              image_classes: 'xl:max-h-screen',
            %}
          {% elsif section.settings.image_two %}
            {% render 'image',
              image_desktop: section.settings.image_two,
              image_mobile: section.settings.image_two,
              width_desktop: '2000x',
              width_mobile: '800x',
              ratio_desktop: '100%',
              ratio_mobile: '100%',
              lazy: true,
              image_classes: 'xl:max-h-screen',
            %}
          {% endif %}

          <div class="{% if section.settings.image_two %} absolute {% else %} lg:absolute {% endif %} bottom-0 left-0 flex flex-col h-full w-full justify-center items-center px-6 md:px-10 pb-7 md:pb-12">
            
            <div class="fs-dsk-only-show head-icon-container {% if section.settings.head_icon_layout_desktop == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_desktop == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-dsk-only-show pb-10 text-center {% unless section.settings.image_head_icon %}lg:pt-[120px]{% endunless %}" style="animation: fadeIn 800ms ease-in-out; width: 100%; ">
              <div class="para-xs pb-2 md:pb-3" style="font-size: {{ section.settings.text_one_size }}px; font-family: {{ section.settings.text_one_font }}; text-align: {{ section.settings.text_one_layout_desktop }};">{{ section.settings.banner_superscript }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1 }}px; font-family: {{ section.settings.banner_heading_font_1 }}; text-align: {{ section.settings.banner_heading_1_layout_desktop }}; ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}; text-align: {{ section.settings.banner_heading_2_layout_desktop }}; ">{{ section.settings.banner_heading_2 | newline_to_br }}</div>
              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_desktop }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>

            <div class="fs-mob-only-show head-icon-container {% if section.settings.head_icon_layout_mobile == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_mobile == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-mob-only-show pb-10 text-center lg:pt-[120px]" style="animation: fadeIn 800ms ease-in-out">
              <div class="para-xs pb-2 md:pb-3" style="font-size: {{ section.settings.text_one_size }}px; font-family: {{ section.settings.text_one_font }}; text-align: {{ section.settings.text_one_layout_mobile }};">{{ section.settings.banner_superscript }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1 }}px; font-family: {{ section.settings.banner_heading_font_1 }}; text-align: {{ section.settings.banner_heading_1_layout_mobile }}; ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}; text-align: {{ section.settings.banner_heading_2_layout_mobile }}; ">{{ section.settings.banner_heading_2 | newline_to_br }}</div>
              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80 max-w-[450px]"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_mobile }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>
             

            {%  assign btn_layout = "" %}
            {% if section.settings.button_layout_desktop == "left" %}
              {% assign btn_layout = "left: 0;    transform: translate(0, 0);    margin-left: 2.5rem;" %}
            {% else if section.settings.button_layout_desktop == "right" %}
              {% assign btn_layout = "right: 0;    transform: translate(0, 0);    margin-right: 2.5rem;" %}
            {% endif %} 
            {% if section.settings.button_layout_desktop == "center" %}
              {% assign btn_layout = "" %}
            {% endif %}
            {% if section.settings.button_border_image != blank %}
              <button class="fs-dsk-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-image-source: url({{ section.settings.button_border_image | img_url }}); border-image-slice: 1; border-image-repeat: stretch; border-width: 2px;">{{ section.settings.button_text }}</button>
            {% else %}
              <button class="fs-dsk-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-color: {{ section.settings.button_border_color }};">{{ section.settings.button_text }}</button>
            {% endif %}



            {%  assign btn_layout_mob = "" %}
            {% if section.settings.button_layout_mobile == "left" %}
              {% assign btn_layout_mob = "right: 50%; margin-left: 20px;" %}
            {% else if section.settings.button_layout_mobile == "right" %}
              {% assign btn_layout_mob = "left: 50%; margin-right: 20px;" %}
            {% endif %} 
            {% if section.settings.button_layout_mobile == "center" %}
              {% assign btn_layout_mob = "" %}
            {% endif %}
            {% if section.settings.button_border_image != blank %}
              <button class="fs-mob-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout_mob}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-image-source: url({{ section.settings.button_border_image | img_url }}); border-image-slice: 1; border-image-repeat: stretch; border-width: 2px;">{{ section.settings.button_text }}</button>
            {% else %}
              <button class="fs-mob-only-show hero-btn fs-dual-img-hero-btn {{ section.settings.button_color }} w-fit absolute bottom-16 md:bottom-12" style="{{btn_layout_mob}}; animation: fadeIn 1000ms ease-in-out; background-color: {{ section.settings.button_colors }}; font-size: {{ section.settings.button_text_size }}px; border-color: {{ section.settings.button_border_color }};">{{ section.settings.button_text }}</button>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </a>
{% else %}
  <section
    class="w-full section-p-b {{ section.settings.padding_bottom }} {% unless section.settings.full_width %} md:section-p-x {% endunless %} overflow-x-hidden {{ section.settings.challenger }}"
    style="color: {{ section.settings.text_color }}"
    {% if section.settings.flush_top %}
      x-init="$store.main.removeHeaderSpacer()"
    {% endif %}
  >
    <div class="relative flex {% if section.settings.flip_orientation %} flex-col lg:flex-row-reverse {% else %} flex-col-reverse lg:flex-row {% endif %} {% if section.settings.full_width %} xl:max-h-screen {% else %} container {% endif %}" style="background-color: {{ section.settings.background_color }}">
      <div class="lg:w-1/2 relative">
        {% if section.settings.image_two %}
          {% render 'image',
            image_desktop: section.settings.image_two,
            image_mobile: section.settings.image_two,
            width_desktop: '2000x',
            width_mobile: '800x',
            ratio_desktop: '100%',
            ratio_mobile: '100%',
            lazy: true,
            image_classes: 'xl:max-h-screen',
          %}
        {% endif %}
        <div class="{% if section.settings.image_two %} absolute {% else %} pt-17 pb-7 lg:py-4 lg:absolute {% endif %} bottom-0 left-0 flex flex-col h-full w-full justify-center items-center px-6 md:px-10 pb-7 md:pb-12">
          <div class="pb-16 md:pb-10 text-center flex flex-col items-center lg:pt-[120px]" style="animation: fadeIn 800ms ease-in-out">
            <div class="para-xs pb-2 md:pb-3" style="font-size: {{ section.settings.text_one_size }}px;">{{ section.settings.banner_superscript }}</div>
            <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1 }}px; font-family: {{ section.settings.banner_heading_font_1 }} ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
            <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}">{{ section.settings.banner_heading_2 | newline_to_br }}</div>

            <div class="para-sm pb-2 md:pb-3 md:pt-6 opacity-80"  style="font-size: {{ section.settings.text_two_size }}px">{{ section.settings.banner_superscript_two }}</div>
          </div>
          <div class="lg:absolute bottom-9 flex w-full justify-center" style="animation: fadeIn 1000ms ease-in-out">
            <img class="max-w-[51px] lg:max-w-[70px]" src="{{ section.settings.icon | img_url: '500x' }}" alt="{{ section.settings.icon.alt }}">
          </div>
        </div>
      </div>
      <div class="lg:w-1/2" style="animation: fadeIn 400ms ease-in-out">
        {% if section.settings.image_one %}
          {% render 'image',g
            image_desktop: section.settings.image_one,
            image_mobile: section.settings.image_one,
            width_desktop: '2000x',
            width_mobile: '800x',
            ratio_desktop: '100%',
            ratio_mobile: '100%',
            lazy: true,
            image_classes: 'xl:max-h-screen',
          %}
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}
{% endif %}
{% schema %}
{
  "name": "Hero | Dual Image Split",
  "class": "section-hero-full-width cw-dual-image-split",
  "settings": [
    {
      "type": "select",
      "id": "champion",
      "options": [
        {
          "label": "New",
          "value": "new"
        },
        {
          "label": "Old",
          "value": "old"
        },
        {
          "label": "Unset",
          "value": "unset"
        }
      ],
      "default": "unset",
      "label": "Champion Users"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        {
          "value": "button",
          "label": "Button"
        },
        {
          "value": "icon",
          "label": "Icon"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image_one",
      "label": "Image One",
      "info": "Aspect Ratio: 1x1 / Min Width: 2000px / JPG"
    },
    {
      "type": "image_picker",
      "id": "image_two",
      "label": "Image Two",
      "info": "Aspect Ratio: 1x1 / Min Width: 2000px / JPG"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile Only",
      "info": "Aspect Ratio: 1x1 / Min Width: 2000px / JPG"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon",
      "info": "Icon Variant Only / Transparent PNG"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "image_picker",
      "id": "image_head_icon",
      "label": "Image Head Icon",
      "info": "Aspect Ratio: 1x1 / Max Width: 250px / PNG"
    },
    {
      "type": "select",
      "id": "head_icon_layout_desktop",
      "label": "Head Icon (Layout-Desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }, 
    {
      "type": "select",
      "id": "head_icon_layout_mobile",
      "label": "Head Icon (Layout-Mobile)",
