{%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
{%- assign pageUrl = contentForQuerystring
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}
<style>
.fs-dsk-only-show{

}
.fs-mob-only-show{
  display: none !important;
}
.h-\[700px\]{
  height: 700px;
}
#shopify-section-{{ section.id }} .fs-dual-img-hero-btn:hover{ 
  color: {{section.settings.button_hover_text_color }} !important;
}
  .head-icon-container {
    display: flex;
    justify-content: center; 
    width: 100%;
  }

  /* Left align the image */
  .head-icon-container-left {
    display: flex;
    justify-content: flex-start;
  }

  /* Right align the image */
  .head-icon-container-right {
    display: flex;
    justify-content: flex-end;
  }
@media only screen and (max-width: 749px) {
  .fs-dsk-only-show{
    display: none !important;
  }
  .fs-mob-only-show{
    display: block !important;
  }
  .fs-mob-only-show.hero-btn{
    line-height: 20px;
  }
  .fs-mob-only-show .heading-2xl{
    /* font-size: 36px !important; */
  }
  .fs-mob-only-show.head-icon-container{
      display: flex !important;
      margin-top: 200px;
    }
}
</style>

{%- liquid 
  assign section_show = false

  if pageUrl contains 'summer' and section.settings.champion == "new"
    assign section_show = true
  elsif pageUrl contains 'first-flush' and section.settings.champion == "old"
    assign section_show = true
  elsif section.settings.champion == "unset"
    assign section_show = true
  endif
-%}

{% if section_show %}
<script>
  const currentRoute = '{{ template }}';

  setTimeout(() => {
    if (currentRoute === 'page.careers-dev' || currentRoute === 'page.careers') {
      const button = document.querySelector('.hero-btn')
      const careersList = document.querySelector('.careers-list')
      const handleClick = (e) => {
        e.preventDefault()
        // scroll to careers list
        careersList.scrollIntoView({ behavior: 'smooth' })
      }
      button.addEventListener('click', handleClick)
    }
  }, 0)


</script>

{% if section.settings.variant == "button" %}
  <a href="{{ section.settings.button_link }}">
    <section
      class="w-full section-p-b {{ section.settings.padding_bottom }} {% unless section.settings.full_width %} md:section-p-x {% endunless %} overflow-x-hidden {{ section.settings.challenger }} cw-champion"
      style="color: {{ section.settings.text_color }}"
      {% if section.settings.flush_top %}
        x-init="$store.main.removeHeaderSpacer()"
      {% endif %}
      x-data="{ fadeIn: false }"
      x-intersect="fadeIn = true"
    >
      <div class="relative flex {% if section.settings.flip_orientation %} flex-col lg:flex-row-reverse {% else %} flex-col-reverse lg:flex-row {% endif %} {% if section.settings.full_width %} xl:max-h-screen overflow-y-hidden {% else %} container {% endif %}" style="background-color: {{ section.settings.background_color }}">
        <div class="h-[500px] md:h-auto lg:w-1/2 relative aspect-auto lg:aspect-auto fs-dsk-only-show">
          {% if section.settings.image_two %}
            {% render 'image',
              image_desktop: section.settings.image_two,
              image_mobile: section.settings.image_two,
              width_desktop: '2000x',
              width_mobile: '800x',
              ratio_desktop: '100%',
              ratio_mobile: '100%',
              lazy: true,
              image_classes: 'xl:max-h-screen',
            %}
          {% endif %}

          <div class="{% if section.settings.image_two %} absolute {% else %} lg:absolute {% endif %} bottom-0 left-0 flex flex-col h-full w-full justify-center items-center px-6 md:px-10 pb-7 md:pb-12">
            
            <div class="fs-dsk-only-show head-icon-container {% if section.settings.head_icon_layout_desktop == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_desktop == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-dsk-only-show pb-10 text-center {% unless section.settings.image_head_icon %}lg:pt-[120px]{% endunless %}" style="animation: fadeIn 800ms ease-in-out; width: 100%;">
              <div class="para-xs pb-2 md:pb-3" style="font-size: {{ section.settings.text_one_size }}px; font-family: {{ section.settings.text_one_font }}; text-align: {{ section.settings.text_one_layout_desktop }};">{{ section.settings.banner_superscript }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1 }}px; font-family: {{ section.settings.banner_heading_font_1 }}; text-align: {{ section.settings.banner_heading_1_layout_desktop }}; ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}; text-align: {{ section.settings.banner_heading_2_layout_desktop }}; ">{{ section.settings.banner_heading_2 | newline_to_br }}</div>
              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_desktop }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>

            <div class="fs-mob-only-show head-icon-container {% if section.settings.head_icon_layout_mobile == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_mobile == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-mob-only-show pb-10 text-center lg:pt-[120px]" style="animation: fadeIn 800ms ease-in-out">
