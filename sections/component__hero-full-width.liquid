{% style %}
  .fs-dsk-only-show{
  }

  .fs-mob-only-show{
    display: none !important;
  }

  .fs-min-400{
    min-width: 400px;
  }

  .fs-h-65{
    height: 65% !important;
  }

  #shopify-section-{{ section.id }} .fs-full-img-hero-btn:hover{
    color: {{section.settings.button_hover_text_color }} !important;
  }
  
  .head-icon-container {
    display: flex;
    justify-content: center; 
  }

  /* Left align the image */
  .head-icon-container-left {
    display: flex;
    justify-content: flex-start;
  }

  /* Right align the image */
  .head-icon-container-right {
    display: flex;
    justify-content: flex-end;
  }

  @media only screen and (min-width: 2200px){
    .fs-ml-10
    {
      margin-left: 10%;
    }
  }

  @media only screen and (max-width: 1050px){
    .fs-h-65{
      height: 90% !important;
    }
  }

   @media (min-width: 768px) and (max-width: 1300px) {
    .fs-dsk-only-show .heading-2xl{
      font-size: 56px !important;
    }
    .fs-h-65{
      height: 70% !important;
    }
  }

  @media (min-width: 768px) and (max-width: 1025px) {
    .ipad-flex-end {
      justify-content: end;
    }
    
  }

  @media (min-width: 768px){
    .fs-height-fit{
      height: auto !important;
      max-height: fit-content !important;
    }
    .h-full-75{
      height: 75%;
    }
    .fs-height-fit-block{
      /* max-height: 100% !important; */
    }
  }

  @media only screen and (max-width: 749px) {
    .fs-dsk-only-show{
      display: none !important;
    }
    .fs-mob-only-show{
      display: block !important;
    }
    .fs-mob-only-show.hero-btn{
      line-height: 20px;
    }
    
    .fs-min-400{
      min-width: 350px;
    }
    .fs-mob-only-show .para-xs{
      padding-left: 0;
      padding-right: 0;
    }
    .fs-mob-only-show.head-icon-container{
      display: flex !important;
      margin-top: 200px;
    }
    .fs-sm-mt-230{
      margin-top: 230px;
    }
  }


  
{% endstyle %}

<section
  class="w-full section-p-b {{ section.settings.padding_bottom }} {% unless section.settings.full_width %} md:section-p-x {% endunless %}"
  style="color: {{ section.settings.text_color }};{% if section.settings.hide_for_abtest %}display:none;{% endif %}"
  {% if section.settings.flush_top %}
    x-init="$store.main.removeHeaderSpacer()"
  {% endif %}
  x-data="{ fadeIn: false }"
  x-intersect.threshold.10="fadeIn = true"
>
<a href="{{ section.settings.button_link }}">

    <div
      class="relative {% if section.settings.full_width %} xl:max-h-screen {% else %} container {% endif %} bg-dark fs-height-fit-block"
      style="animation: fadeIn 300ms ease-in-out;"
    >

      {% if section.settings.asset_type == 'image' %}
        {% if section.settings.full_width %}
          {% render 'image',
            image_desktop: section.settings.image_desktop,
            image_mobile: section.settings.image_mobile,
            width_desktop: '2000x',
            width_mobile: '800x',
            ratio_desktop: '56.25%',
            ratio_mobile: '173%',
            lazy: false,
            image_classes: 'xl:max-h-screen'
          %}
        {% else %}
          {% render 'image',
            image_desktop: section.settings.image_desktop,
            image_mobile: section.settings.image_mobile,
            width_desktop: '2000x',
            width_mobile: '800x',
            ratio_desktop: '56.25%',
            ratio_mobile: '173%',
            lazy: false,
            image_classes: ''
          %}
        {% endif %}

      {% else %}
        {% assign desktop_url = section.settings.video_desktop.sources[1].url %}
        {% assign mobile_url = section.settings.video_mobile.sources[1].url %}
        {% if section.settings.full_width %}
          <div>
            <video
              class="hidden md:block w-full h-full object-cover section-height-screen fs-height-fit"
              src="{{ desktop_url }}"
              x-data
              x-ref="video"
              autoplay
              muted
            ></video>
          </div>
          <video
            class="md:hidden w-full h-full object-cover section-height-screen"
            src="{% if mobile_url != blank %}{{ mobile_url }}{% else %}{{ desktop_url }}{% endif %}"
            x-data
            x-ref="video"
            autoplay
            muted
            loop
            playsinline
          ></video>
        {% else %}
          <video
            class="hidden md:block w-full h-full object-cover"
            src="{{ desktop_url }}"
            x-data
            x-ref="video"
            autoplay
            muted
          ></video>
          <video
            class="md:hidden w-full h-full object-cover"
            src="{% if mobile_url != blank %}{{ mobile_url }}{% else %}{{ desktop_url }}{% endif %}"
            x-data
            x-ref="video"
            autoplay
            muted
          ></video>
        {% endif %}
      {% endif %}

      <div class="absolute bottom-16 md:bottom-0 flex {% if section.settings.cta_orientation_vertical == 'middle' %} fs-h-65  md:h-[80%] 2xl:h-[53%] {% else %} h-full pt-12 {% endif %} w-full items-center px-6 pt-10 md:px-10 pb-20 md:pb-12 {% if section.settings.cta_orientation == 'center' %} justify-center {% else %} justify-center md:justify-start {% endif %}">
        <div class="flex flex-col items-start w-fit h-full
        {% if section.settings.cta_ori_vert_mob == 'bottom' %}  fs-sm-mt-230  {% endif %}
         {% if template == '404' %}ipad-flex-end{% endif %} 
         {% if section.settings.cta_orientation == 'center'%}  {% else %} fs-ml-10 {% endif %}" 
         {% if template == '404' %}style="z-index:1;"{% endif %}>
          <div
            class="pb-10 max-w-[650px] xl:max-w-[800px] {% if section.settings.cta_orientation == 'center'%} text-center {% else %} text-center md:text-left {% endif %}"
            style="animation: fadeIn 1000ms ease-in-out;"
          >
            <div class="fs-dsk-only-show head-icon-container {% if section.settings.head_icon_layout_desktop == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_desktop == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-dsk-only-show fs-min-400 pb-10 text-center" style="animation: fadeIn 800ms ease-in-out;">
              <div class="para-xs pb-2 md:pb-3 px-5" style="font-size: {{ section.settings.text_one_size }}px; font-family: {{ section.settings.text_one_font }}; text-align: {{ section.settings.text_one_layout_desktop }};">{{ section.settings.banner_superscript }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1 }}px; font-family: {{ section.settings.banner_heading_font_1 }}; text-align: {{ section.settings.banner_heading_1_layout_desktop }}; ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}; text-align: {{ section.settings.banner_heading_2_layout_desktop }}; ">{{ section.settings.banner_heading_2 | newline_to_br }}</div>
              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80 max-w-[450px]"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_desktop }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>

            <div class="fs-mob-only-show head-icon-container {% if section.settings.head_icon_layout_mobile == 'left' %} head-icon-container-left {% elsif section.settings.head_icon_layout_mobile == 'right'%} head-icon-container-right {% endif %}  ">
              {% if section.settings.image_head_icon %}
                <img src="{{ section.settings.image_head_icon | img_url: 'original' }}" alt="Image Head Icon">
              {% endif %}
            </div>
            <div class="fs-mob-only-show fs-min-400  pb-10 text-center lg:pt-[120px]" style="animation: fadeIn 800ms ease-in-out;">
              <div class="para-xs pb-2 md:pb-3 px-5" style="font-size: {{ section.settings.text_one_size }}px; font-family: {{ section.settings.text_one_font }}; text-align: {{ section.settings.text_one_layout_mobile }};">{{ section.settings.banner_superscript }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_1_mob }}px; font-family: {{ section.settings.banner_heading_font_1 }}; text-align: {{ section.settings.banner_heading_1_layout_mobile }}; ">{{ section.settings.banner_heading_1 | newline_to_br }}</div>
              <div class="heading-2xl md:heading-xl xl:heading-2xl" style="font-size: {{ section.settings.heading_text_size_2 }}px; font-family: {{ section.settings.banner_heading_font_2 }}; text-align: {{ section.settings.banner_heading_2_layout_mobile }}; ">{{ section.settings.banner_heading_2 | newline_to_br }}</div>
              <div class="para-sm pb-2 md:pb-3 pt-5 md:pt-6 opacity-80 max-w-[450px]"  style="font-size: {{ section.settings.text_two_size }}px; font-family: {{ section.settings.text_two_font }}; text-align: {{ section.settings.text_two_layout_mobile }}; ">{{ section.settings.banner_superscript_two }}</div>
            </div>

          </div>
          
          {% if section.settings.button_link %}
            {%  assign btn_layout = "" %}
            {% if section.settings.button_layout_desktop == "left" %}
              {% assign btn_layout = "margin-left: 0 !important;    margin-right: auto !important;" %}
            {% else if section.settings.button_layout_desktop == "right" %}
              {% assign btn_layout = "margin-left: auto !important;    margin-right: 0 !important;" %}
            {% endif %} 
            {% if section.settings.button_layout_desktop == "center" %}
              {% assign btn_layout = "margin-left: auto !important;    margin-right: auto !important;" %}
            {% endif %}
            <button class="fs-dsk-only-show fs-full-img-hero-btn {{ section.settings.button_color }} w-fit mx-auto md:mx-0 {% if section.settings.cta_orientation == 'center '%} md:mx-auto {% endif %}"
            style="animation: fadeIn 1400ms ease-in-out; font-size: {{ section.settings.button_text_size }}px; color: {{ section.settings.button_text_color }}; {{btn_layout}}">
              {{- section.settings.button_text -}}
            </button>

            {%  assign btn_layout_mob = "" %}
            {% if section.settings.button_layout_mobile == "left" %}
              {% assign btn_layout_mob = "margin-left: 0 !important;    margin-right: auto !important;" %}
            {% else if section.settings.button_layout_mobile == "right" %}
              {% assign btn_layout_mob = "margin-left: auto !important;    margin-right: 0 !important;" %}
            {% endif %} 
            {% if section.settings.button_layout_mobile == "center" %}
              {% assign btn_layout_mob = "margin-left: auto !important;    margin-right: auto !important;" %}
            {% endif %}
            <button class="fs-mob-only-show fs-full-img-hero-btn {{ section.settings.button_color }} w-fit mx-auto md:mx-0 {% if section.settings.cta_orientation == 'center '%} md:mx-auto {% endif %}"
            style="animation: fadeIn 1400ms ease-in-out;     padding-bottom: 65px; font-size: {{ section.settings.button_text_size }}px; color: {{ section.settings.button_text_color }}; {{btn_layout_mob}}">
              {{- section.settings.button_text -}}
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </a>

</section>

{% schema %}
{
  "name": "Hero | Full Width",
  "class": "section-hero-full-width",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "asset_type",
      "label": "Asset Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image - Desktop",
      "info": "Aspect Ratio: 16x9 / Min Width: 2500px / JPG"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image - Mobile",
      "info": "This image will only be used on mobile devices. If blank, the desktop image will be used."
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Video - Desktop"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video - Mobile",
      "info": "This video will only be used on mobile devices. If blank, the desktop video will be used."
    },
    {
      "type": "header",
      "content": "A/B Test Settings"
    },
    {
      "type": "checkbox",
      "id": "hide_for_abtest",
      "label": "Hide for A/B Test",
      "default": false
    },

    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "image_picker",
      "id": "image_head_icon",
      "label": "Image Head Icon",
      "info": "Aspect Ratio: 1x1 / Max Width: 250px / PNG"
    },
    {
      "type": "select",
      "id": "head_icon_layout_desktop",
      "label": "Head Icon (Layout-Desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }, 
    {
      "type": "select",
      "id": "head_icon_layout_mobile",
      "label": "Head Icon (Layout-Mobile)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }, 
    {
      "type": "richtext",
      "id": "banner_superscript",
