    "component_three_up_image_text_bXHyWb": {
      "type": "component__three-up-image-text",
      "blocks": {
        "column_r7Uy8C": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/RTB_Relationships.jpg",
            "title": "OUR CLOSE, LONG-TERM RELATIONSHIPS",
            "copy": "<p>We cultivate direct, long-term partnerships with growers and artisans across the world to bring you an authentic and meaningful experience of tea. This approach ensures a stable source of income for producers—and preserves a legacy of extraordinary craftsmanship.<\/p>"
          }
        },
        "column_xrEbHC": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/RTB_Selector.jpg",
            "title": "WE SELECT ONLY THE BEST, FROM THE BEST",
            "copy": "<p>We provide an unparalleled and immersive sensory experience, traveling each year to remote, pristine growing regions—where tea cultivation spans generations—in pursuit of the finest, purest ingredients.<\/p>"
          }
        },
        "column_hpwnBQ": {
          "type": "column",
          "settings": {
            "image": "shopify:\/\/shop_images\/D2_LIFESTYLE_11_RITUALGREEN_2276_FINAL_1.jpg",
            "title": "OUR BALANCE OF TRADITION AND INNOVATION",
            "copy": "<p>We offer a beautiful, balanced cup that calms and captivates the mind, infusing modern culinary creativity with ancient botanical wisdom in our original, innovative blends.<\/p>"
          }
        }
      },
      "block_order": [
        "column_r7Uy8C",
